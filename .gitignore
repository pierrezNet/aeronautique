# Cache de l'outil Cloudflare Wrangler (vestige d'un autre projet, n'a rien à faire ici)
.wrangler/

# Configuration des éditeurs / IDE
.idea/
.DS_Store

# Réglages locaux de l'assistant Claude
.claude/settings.local.json

# Fichiers Markdown : docs pour l'assistant (CLAUDE.md) et notes de travail.
# On garde le README, page d'accueil publique du dépôt.
*.md
!README.md
# Documentation de l'Atelier réglages (dépôt ouvert aux contributions)
!reglages/README.en.md
!reglages/CONTRIBUTING.md

# Dépendances Node éventuelles (l'Atelier réglages n'en a aucune)
node_modules/

# Fichiers temporaires FUSE (fichier supprimé encore ouvert sur un disque monté)
.fuse_hidden*
